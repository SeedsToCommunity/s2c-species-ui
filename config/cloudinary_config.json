{
  "image_groups": {
    "identification_lake_county_photos": {
      "label": "Lake County - Cloudinary - Identification",
      "description": "Cloudinary photos for this species",
      "icon": "image",
      "tags": ["Lake County"],
      "filename_patterns": ["{botanical_name}", "png"],
      "default_screens": ["identification"],
      "display_style": "gallery"
    },
    "collection_lake_county_photos": {
      "label": "Cloudinary Lake County Species Photos",
      "description": "Cloudinary photos for this species",
      "icon": "image",
      "tags": ["Lake County"],
      "filename_patterns": ["{botanical_name}", "png"],
      "default_screens": ["collection"],
      "display_style": "gallery"
    },
    "species_photos": {
      "label": "Cloudinary Lake County Seed Species Photos",
      "description": "Cloudinary photos for this species",
      "icon": "image",
      "tags": ["Lake County", "seeds"],
      "filename_patterns": ["{botanical_name}", "png"],
      "default_screens": ["collection"],
      "display_style": "gallery"
    }
  },
  "species_matching": {
    "primary_method": "filename",
    "filename_format": "{genus}_{species}",
    "tag_format": "species:{genus}_{species}",
    "fallback_to_genus": false,
    "genus_tag_format": "genus:{genus}"
  },
  "cache_settings": {
    "ttl_hours": 1,
    "cache_directory": "/tmp/cloudinary_cache"
  }
}
